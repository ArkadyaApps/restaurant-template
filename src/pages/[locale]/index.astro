---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroSection from "@/components/HeroSection.astro";
import OpeningHours from "@/components/OpeningHours.astro";
import ContactSection from "@/components/ContactSection.astro";
import InstagramFeed from "@/components/InstagramFeed.astro";
import ReservationStrip from "@/components/ReservationStrip.astro";
import Ornament from "@/components/Ornament.astro";
import { useTranslations, localizedPath, type Locale, locales } from "@/i18n/utils";
import { siteConfig } from "@/config/site";

export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
---

<BaseLayout
  title={`${siteConfig.name} — ${t("hero.eyebrow")}`}
  description={t("hero.subtitle")}
>
  <HeroSection locale={locale} />

  <!-- About — asymmetric pullquote split -->
  <section id="about" class="container-narrow py-14 md:py-24">
    <div class="grid md:grid-cols-12 gap-8 md:gap-14 items-start">
      <div class="md:col-span-5 md:sticky md:top-32 reveal">
        <p class="eyebrow mb-5">{t("about.title")}</p>
        <p
          class="display italic text-4xl md:text-6xl text-[var(--color-gold-soft)] leading-[1.02]"
        >
          "{t("about.pullquote")}"
        </p>
        <div
          class="mt-8 flex items-center gap-3 text-[var(--color-gold)]"
          aria-hidden="true"
        >
          <span
            class="block h-px w-16 bg-gradient-to-r from-[var(--color-gold-deep)] via-[var(--color-gold)] to-transparent opacity-70"
          ></span>
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="0.7"
          >
            <path
              d="M12 3 L13.5 10.5 L21 12 L13.5 13.5 L12 21 L10.5 13.5 L3 12 L10.5 10.5 Z"
              opacity="0.85"></path>
            <circle cx="12" cy="12" r="1" fill="currentColor"></circle>
          </svg>
        </div>
      </div>
      <div
        class="md:col-span-6 md:col-start-7 md:border-l md:border-[var(--color-line)] md:pl-10 reveal reveal-d2"
      >
        <p class="text-lg md:text-xl text-[var(--color-fg-muted)] leading-loose font-light">
          {t("about.body")}
        </p>
      </div>
    </div>
  </section>

  <!-- Menu — draggable scattered-photo reel, not a grid -->
  {
    siteConfig.images.menu.length > 0 && (
      <section class="py-10 md:py-16 reveal overflow-hidden">
        <div class="container-narrow flex items-end justify-between gap-6 mb-4">
          <div>
            <p class="eyebrow mb-3">{t("menu.title")}</p>
            <p class="display italic text-3xl md:text-4xl text-[var(--color-gold-soft)]">
              {t("menu.intro")}
            </p>
          </div>
          <a
            href={localizedPath(locale, "/menu")}
            class="hidden md:inline-block text-[0.7rem] uppercase tracking-[0.22em] text-[var(--color-gold-deep)] hover:text-[var(--color-gold)] transition-colors shrink-0 mb-2"
          >
            {t("menu.title")} →
          </a>
        </div>

        <div class="reel-track" data-reel>
          {siteConfig.images.menu.map((src, i) => (
            <div class="reel-card">
              <div class="reel-card-frame">
                <img src={src} alt={`${t("menu.title")} ${i + 1}`} loading="lazy" />
              </div>
            </div>
          ))}
        </div>

        <div class="container-narrow">
          <a
            href={localizedPath(locale, "/menu")}
            class="md:hidden inline-block text-[0.7rem] uppercase tracking-[0.22em] text-[var(--color-gold-deep)]"
          >
            {t("menu.title")} →
          </a>
        </div>
      </section>
    )
  }

  <div class="reveal">
    <ReservationStrip locale={locale} />
  </div>

  <div id="hours" class="reveal">
    <OpeningHours locale={locale} />
  </div>

  <div class="reveal">
    <InstagramFeed locale={locale} />
  </div>
  <div class="reveal">
    <ContactSection locale={locale} />
  </div>
</BaseLayout>
